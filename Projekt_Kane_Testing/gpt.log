    # Locate the object
    object_location = locate(object_name)
    if object_location is None:
        print(f"Could not find {object_name}")
        return

    # Plan a motion to the object
    motion_plan = plan_motion(object_location)
    if motion_plan is None:
        print(f"Could not plan a motion to {object_name}")
        return

    # Execute the motion plan
    for motion in motion_plan:
        if motion['type'] == 'push':
            push(motion['direction'])
        elif motion['type'] == 'pull':
            pull(motion['direction'])

    # Grab the object
